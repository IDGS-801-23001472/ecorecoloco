diff --git a/backend/scripts/migrate-imports.js b/backend/scripts/migrate-imports.js
new file mode 100644
index 0000000..ecd8163
--- /dev/null
+++ b/backend/scripts/migrate-imports.js
@@ -0,0 +1,172 @@
+const { randomBytes, scrypt } = require('node:crypto');
+const { promisify } = require('node:util');
+const { Types } = require('mongoose');
+const models = require('../src/models');
+const { embeddedNeighborhoodId } = require('../src/services/embedded-neighborhood');
+
+const derive = promisify(scrypt);
+const active = row => ({ activo: row.activo ?? (row.estado === 1) });
+const normalized = value => value?.trim().toLowerCase() || null;
+
+async function migrate(Model, legacyKey, marker, transform) {
+  let count = 0;
+
+  for await (const row of Model.collection.find({
+    [legacyKey]: { $exists: true },
+    [marker]: { $exists: false },
+  })) {
+    try {
+      const { values, unset = {} } = await transform(row);
+      const result = await Model.collection.updateOne(
+        { _id: row._id, [marker]: { $exists: false } },
+        { $set: values, $unset: unset }
+      );
+      count += result.modifiedCount;
+    } catch (error) {
+      // Los errores del driver pueden contener valores de los documentos.
+      const reason = error.code === 11000
+        ? 'un valor único ya existe en otro documento'
+        : error instanceof MigrationError
+          ? error.message
+          : 'falló la actualización en MongoDB';
+      throw new Error(`${Model.collection.name} (${legacyKey}=${row[legacyKey]}): ${reason}.`);
+    }
+  }
+
+  return count;
+}
+
+class MigrationError extends Error {}
+
+function requireReference(map, key, label) {
+  if (key == null) return null;
+  const value = map.get(key);
+  if (!value) throw new MigrationError(`falta la referencia a ${label} ${key}`);
+  return value;
+}
+
+async function referenceMap(Model, key) {
+  const rows = await Model.collection.find(
+    { [key]: { $exists: true } },
+    { projection: { [key]: 1 } }
+  ).toArray();
+  return new Map(rows.map(row => [row[key], row._id]));
+}
+
+async function migrateNeighborhoods() {
+  const neighborhoods = new Map();
+
+  for await (const sector of models.Sector.collection.find({ colonias: { $type: 'array' } })) {
+    for (const [index, col] of sector.colonias.entries()) {
+      if (!col?.nombre) continue;
+      const _id = embeddedNeighborhoodId(sector._id, col, index);
+      await models.Neighborhood.collection.updateOne(
+        { _id },
+        {
+          $setOnInsert: {
+            sectorId: sector._id,
+            nombre: col.nombre,
+            codigoPostal: col.codigo_postal,
+            activo: active(sector).activo,
+          },
+        },
+        { upsert: true }
+      );
+      neighborhoods.set(
+        JSON.stringify([sector.nombre, col.nombre, String(col.codigo_postal)]),
+        _id
+      );
+    }
+  }
+
+  return neighborhoods;
+}
+
+async function migrateImports() {
+  let count = 0;
+  for (const [Model, key] of [
+    [models.Sector, 'pk_sector'],
+    [models.CommercialActivity, 'pk_actividad_comercial'],
+    [models.PaymentMethod, 'pk_metodo_pago'],
+  ]) {
+    count += await migrate(Model, key, 'activo', row => ({ values: active(row) }));
+  }
+
+  count += await migrate(models.Shift, 'pk_turno', 'horaInicio', row => ({
+    values: {
+      ...active(row),
+      horaInicio: row.hora_inicio.slice(0, 5),
+      horaFin: row.hora_fin.slice(0, 5),
+    },
+  }));
+
+  count += await migrate(models.Waste, 'pk_desecho', 'unidadMedida', row => ({
+    values: {
+      ...active(row),
+      unidadMedida: row.unidad_medida,
+      precio: Types.Decimal128.fromString(String(row.precio)),
+    },
+  }));
+
+  const roles = await referenceMap(models.Role, 'codigo');
+  count += await migrate(models.User, 'pk_usuario', 'usuarioNormalizado', async row => {
+    const rolId = requireReference(roles, row.rol?.id, 'rol');
+    if (!rolId) throw new MigrationError('falta el rol');
+    let passwordHash = row.passwordHash;
+    if (!passwordHash) {
+      if (typeof row.pass !== 'string' || !row.pass) {
+        throw new MigrationError('falta la contraseña de la cuenta importada');
+      }
+      const salt = randomBytes(16).toString('hex');
+      passwordHash = `scrypt:${salt}:${(await derive(row.pass, salt, 64)).toString('hex')}`;
+    }
+    return {
+      values: {
+        ...active(row),
+        rolId,
+        usuarioNormalizado: normalized(row.usuario),
+        correoNormalizado: normalized(row.correo),
+        passwordHash,
+      },
+      unset: { pass: '' },
+    };
+  });
+
+  const users = await referenceMap(models.User, 'pk_usuario');
+  const activities = await referenceMap(models.CommercialActivity, 'pk_actividad_comercial');
+  const neighborhoods = await migrateNeighborhoods();
+
+  count += await migrate(models.Driver, 'pk_chofer', 'cuentaId', row => ({
+    values: {
+      ...active(row),
+      cuentaId: requireReference(users, row.fk_usuario, 'usuario'),
+      numeroLicencia: row.numero_licencia,
+      vencimientoLicencia: row.vencimiento_licencia,
+      fechaIngreso: row.fecha_ingreso,
+    },
+  }));
+
+  count += await migrate(models.Client, 'pk_cliente', 'cuentaId', row => {
+    const address = row.direccion ?? {};
+    return {
+      values: {
+        ...active(row),
+        cuentaId: requireReference(users, row.fk_usuario, 'usuario'),
+        actividadComercialId: requireReference(activities, row.actividad_comercial?.id, 'actividad comercial'),
+        razonSocial: row.razon_social,
+        direccion: typeof address === 'string'
+          ? address
+          : [address.calle, address.colonia, address.municipio, address.estado]
+            .filter(Boolean).join(', '),
+        coloniaId: neighborhoods.get(
+          JSON.stringify([address.sector, address.colonia, String(address.codigo_postal)])
+        ) ?? null,
+        codigoPostal: address.codigo_postal ?? row.codigo_postal ?? null,
+      },
+    };
+  });
+
+  return count;
+}
+
+module.exports = { migrateImports };
